        "drupal/inline_entity_form": "^1.0@RC",
        "drupal/ip2country": "^2",
        "drupal/jquery_ui": "^1.4",
        "drupal/jsonapi_views": "^1.0",
        "drupal/layout_builder_restrictions": "^2.13",
        "drupal/linkit": "^6.0@beta",
        "drupal/mail_login": "^3",
        "drupal/mailsystem": "^4.3",
        "drupal/masonry": "^4",
        "drupal/masonry_views": "^4",
        "drupal/media_library_theme_reset": "^1.5",
        "drupal/menu_block": "^1.8",
        "drupal/menus_attribute": "^1.3",
        "drupal/message": "^1.2",
        "drupal/metatag": "^2.1",
