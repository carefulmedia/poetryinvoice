        "drupal/reroute_email": "^2.3@RC",
        "drupal/s3fs": "^3.0@beta",
        "drupal/scanner": "^2.0@beta",
        "drupal/scheduler": "^1.4",
        "drupal/search_api": "^1.25",
        "drupal/search_api_solr": "4.3.10",
        "drupal/select_translation": "^2.0@alpha",
        "drupal/simple_sitemap": "^4.2",
        "drupal/slick": "^3.0",
        "drupal/slick_views": "^3.0",
