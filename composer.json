        "drupal/text_field_formatter": "^2.0",
        "drupal/upgrade_status": "^4.3",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_bootstrap": "^5.5@alpha",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.1",
        "drupal/views_conditional": "^1.5",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_random_seed": "^1.2",
        "drupal/views_slideshow": "^5.0",
        "drupal/votingapi": "4.0.x-dev@dev",
        "drush/drush": "^13",
        "ganlanyuan/tiny-slider": "^2.9",
        "geocoder-php/google-maps-provider": "^4.7",
        "jaybizzle/crawler-detect": "^1.2",
        "mglaman/composer-drupal-lenient": "^1.0",
        "mikehaertl/phpwkhtmltopdf": "~2.1",
        "owlcarousel2/owlcarousel2": "^2.3",
        "palantirnet/drupal-rector": "^0.21.1",
        "platformsh/config-reader": "^2.4",
        "tecnickcom/tcpdf": "~6",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mglaman/composer-drupal-lenient": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "patches": {
            "drupal/core": {
                "Field layout undefined array key 'region'; https://www.drupal.org/project/field_layout/issues/3053906": "https://www.drupal.org/files/issues/2024-10-29/undefined_index_region_field_layout-3053906-66.patch"
            },
            "drupal/focal_point": {
                "Focal point not working with convert": "patches/focal_point-fixing-focal-point-work-with-convert.patch"
            },
            "drupal/tablesorter": {
                "Automated Drupal 11 compatibility fixes for tablesorter": "https://www.drupal.org/files/issues/2024-03-25/tablesorter.8.x-1.x-dev.rector.patch"
            },
            "drupal/menus_attribute": {
                "Automated Drupal 11 compatibility fixes for menus_attribute": "https://www.drupal.org/files/issues/2025-05-31/menus_attribute.1.x-dev.rector.patch"
            }
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/masonry/composer.libraries.json",
                "web/modules/contrib/anchor_link/composer.libraries.json"
            ]
        },
        "enable-patching": true,
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/development.services.yml": false,
                "[web-root]/sites/default/default.settings.php": false,
                "[web-root]/sites/default/default.services.yml": false,
                "[web-root]/.htaccess": false,
                "[web-root]/robots.txt": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "drupal-lenient": {
            "allowed-list": ["drupal/tablesorter", "drupal/menus_attribute", "drupal/owlcarousel"]
        }
    },
    "scripts": {
        "run-migrations": [
            "drush pmu pathauto -y",
            "drush mim --group=migrate_drupal_7",
            "drush cim -y"
        ],
        "post-install-cmd": [
            "@composer drupal:scaffold"
        ],
        "post-update-cmd": [
            "@composer drupal:scaffold",
            "mkdir -p web/libraries/bootstrap",
            "cp -R vendor/twbs/bootstrap/dist web/libraries/bootstrap"
        ]
    },
    "require-dev": {
        "kint-php/kint": "^6.0"
    }
}
