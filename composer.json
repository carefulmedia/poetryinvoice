        "drupal/block_styles": "^2.0",
        "drupal/bootstrap_barrio": "^5.5",
        "drupal/bootstrap_layout_builder": "^2.1",
        "drupal/bootstrap_layouts": "^5.2",
        "drupal/bootstrap_sass": "^5.0",
        "drupal/bootstrap_styles": "^1.0",
        "drupal/captcha": "^2",
        "drupal/chosen": "^3.0",
