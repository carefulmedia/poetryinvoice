        "drupal/mimemail": "^2.0",
        "drupal/other_view_filter": "1.x-dev@dev",
        "drupal/owlcarousel": "^3.0",
        "drupal/page_specific_class": "^2.0",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/prepopulate": "^2.3",
