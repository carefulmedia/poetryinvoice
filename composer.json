        "drupal/admin_toolbar": "^3.0",
        "drupal/anchor_link": "^3.0@alpha",
        "drupal/animate_on_scroll": "3.0.x-dev@dev",
        "drupal/auto_entitylabel": "^3.0",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/blazy": "^3.0",
        "drupal/block_styles": "^2.0",
        "drupal/bootstrap_barrio": "^5.5",
        "drupal/bootstrap_layout_builder": "^2.1",
        "drupal/bootstrap_layouts": "^5.2",
        "drupal/bootstrap_sass": "^5.0",
        "drupal/bootstrap_styles": "^1.0",
        "drupal/captcha": "^2",
        "drupal/chosen": "^3.0",
        "drupal/ckeditor_indentblock": "^1.1",
        "drupal/coder": "^8.3",
        "drupal/components": "^3.0@beta",
        "drupal/composer_deploy": "^1.10",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_filter": "^2.6",
        "drupal/config_ignore": "^3.2",
        "drupal/config_log": "^3.0",
        "drupal/config_pages": "^2.18",
        "drupal/content_lock": "^3.0@alpha",
        "drupal/core": "^11.3",
        "drupal/core-composer-scaffold": "^11.3",
        "drupal/core-project-message": "^11.3",
        "drupal/ctools": "^4.1",
        "drupal/devel": "^5",
        "drupal/devel_php": "^1.3",
        "drupal/diff": "^1.8",
        "drupal/drupal-extension": "^5.2",
        "drupal/editablefields": "1.0.x-dev@dev",
        "drupal/entity_print": "^2.6",
        "drupal/exif_orientation": "^1.4",
        "drupal/facebook_pixel": "^2.0@RC",
        "drupal/fakeobjects": "^1.1",
        "drupal/field_group": "^3.2",
        "drupal/field_permissions": "^1.3",
        "drupal/focal_point": "^2",
        "drupal/form_mode_manager": "^3",
        "drupal/forum": "^1.0",
        "drupal/geocoder": "^4.23",
        "drupal/geofield": "^1.55",
        "drupal/geolocation": "^3.12",
        "drupal/gin": "^5.0",
        "drupal/google_analytics": "^4.0",
        "drupal/html_titles": "^1.1",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/ip2country": "^2",
        "drupal/jquery_ui": "^1.4",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/jsonapi_views": "^1.0",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/linkit": "^7.0",
        "drupal/mail_login": "^4.2",
        "drupal/mailsystem": "^4.3",
        "drupal/masonry": "^4.1",
        "drupal/masonry_views": "^4.1",
        "drupal/menu_block": "^1.8",
        "drupal/menus_attribute": "1.x-dev@dev",
        "drupal/message": "^1.2",
        "drupal/metatag": "^2.1",
