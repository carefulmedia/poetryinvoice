{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "0": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/account_modal": "^1.0@RC",
        "drupal/adaptivetheme": "^5.1",
        "drupal/address": "^1.9",
        "drupal/admin_toolbar": "^3.0",
        "drupal/adminimal_theme": "^1.6",
        "drupal/better_exposed_filters": "^5.2",
        "drupal/block_styles": "^2.0",
        "drupal/bootstrap_barrio": "^5.5",
        "drupal/bootstrap_layout_builder": "^1.2",
        "drupal/bootstrap_layouts": "^5.2",
        "drupal/bootstrap_styles": "^1.0",
        "drupal/chosen": "^3.0",
        "drupal/coder": "^8.3",
        "drupal/components": "^3.0@beta",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_ignore": "^2.3",
        "drupal/content_lock": "^2.2",
        "drupal/core-composer-scaffold": "^9",
        "drupal/core-project-message": "^9",
        "drupal/core-recommended": "^9",
        "drupal/ctools": "3.11-rc1",
        "drupal/devel_php": "^1.3",
        "drupal/editablefields": "^1.0@beta",
        "drupal/entity_print": "^2.6",
        "drupal/fancy_login": "^3.0",
        "drupal/field_group": "^3.2",
        "drupal/field_permissions": "^1.1",
        "drupal/fivestar": "^1.0@alpha",
        "drupal/focal_point": "^1.5",
        "drupal/form_mode_manager": "^2.0@RC",
        "drupal/gin": "^3.0@beta",
        "drupal/imce": "^2.4",
        "drupal/inline_entity_form": "^1.0@RC",
        "drupal/ip2country": "^1.10",
        "drupal/jquery_ui": "^1.4",
        "drupal/jsonapi_views": "^1.0",
        "drupal/layout_builder_restrictions": "^2.13",
        "drupal/linkit": "^6.0@beta",
        "drupal/mail_login": "^2.0",
        "drupal/mailsystem": "^4.3",
        "drupal/masonry": "^1.2",
        "drupal/masonry_views": "^1.1",
        "drupal/menu_block": "^1.8",
        "drupal/message": "^1.2",
        "drupal/migrate_plus": "^5",
        "drupal/migrate_tools": "^5",
        "drupal/migrate_upgrade": "^3",
        "drupal/mimemail": "^1.0@alpha",
        "drupal/multiple_registration": "^3.1",
        "drupal/page_specific_class": "^2.0",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/prepopulate": "^2.3",
        "drupal/profile": "^1.4",
        "drupal/quick_node_clone": "^1.15",
        "drupal/realname": "^2.0@beta",
        "drupal/redirect": "^1.7",
        "drupal/reroute_email": "^2.1",
        "drupal/responsive_menu": "^4.4",
        "drupal/s3fs": "^3.0@beta",
        "drupal/scanner": "1.x-dev@dev",
        "drupal/scheduler": "^1.4",
        "drupal/select_translation": "^2.0@alpha",
        "drupal/slick": "^2.6",
        "drupal/slick_views": "^2.6",
        "drupal/social_link_field": "1.x-dev@dev",
        "drupal/string_field_formatter": "^2.0",
        "drupal/svg_image": "^1.16",
        "drupal/tablesorter": "^2.0@RC",
        "drupal/tb_megamenu": "^1.7",
        "drupal/text_field_formatter": "^2.0",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_bootstrap": "^5.5@alpha",
        "drupal/views_bulk_edit": "^2.6",
        "drupal/views_bulk_operations": "^4.1",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_json_source": "^1.3",
        "drupal/zen": "^7.0@alpha",
        "drush/drush": "^10",
        "mikehaertl/phpwkhtmltopdf": "~2.1",
        "platformsh/config-reader": "^2.4",
        "tecnickcom/tcpdf": "~6",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "web/modules/contrib/masonry/composer.libraries.json"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/core": {
                "Passing null to parameter #1 ($num) of type int|float to abs() is deprecated": "https://www.drupal.org/files/issues/2022-02-23/3261229-19.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/development.services.yml": false,
                "[web-root]/sites/default/default.settings.php": false,
                "[web-root]/.htaccess": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "scripts": {
        "run-migrations": [
            "drush pmu pathauto -y",
            "drush mim --group=migrate_drupal_7",
            "drush cim -y"
        ]
    },
    "require-dev": {
        "kint-php/kint": "^4.1"
    }
}
