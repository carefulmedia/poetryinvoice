        "drupal/views_conditional": "^1.5",
        "drupal/views_field_view": "^1.0@beta",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_json_source": "^1.3",
        "drupal/views_random_seed": "^1.2",
        "drupal/views_slideshow": "^5.0",
        "drupal/votingapi": "^3.0@beta",
        "drush/drush": "^12",
