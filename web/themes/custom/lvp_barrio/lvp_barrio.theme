<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\piv_base\Controller\PoemFavouritesController;
use Drupal\piv_base\PoemFavouritesStorage;
use Drupal\user\Entity\User;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 * Example on how to alter theme settings form
 */
function lvp_barrio_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_barrio_navbar_top_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
  $form['components']['navbar']['bootstrap_barrio_navbar_background']['#options'] = [
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  ];
}

/**
 * Make language variable available in twig files
 */
function lvp_barrio_preprocess_block(&$vars) {

  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;
}

/**
 * Use language code for the language switcher
 */
function lvp_barrio_preprocess_links__language_block(&$variables) {
  foreach ($variables['links'] as $i => $link) {
    // @var \Drupal\language\Entity\ConfigurableLanguage $linkLanguage
    $linkLanguage = $link['link']['#options']['language'];
    $variables['links'][$i]['link']['#title'] = $linkLanguage->get('id');
  }
}


function lvp_barrio_preprocess_page(&$variables) {
  switch (theme_get_setting('bootstrap_barrio_navbar_offcanvas')) {
    case 'offcanvas-collapse':
      $variables['navbar_offcanvas'] = TRUE;
      $variables['navbar_collapse_class'] = "offcanvas offcanvas-top";
      $variables['navbar_collapse_btn_data'] = "offcanvas";
      break;
    default:
      $variables['navbar_offcanvas'] = TRUE;
      $variables['navbar_collapse_class'] = 'collapse navbar-collapse justify-content-end';
      $variables['navbar_collapse_btn_data'] = "collapse";
  }

  $variables['page']['header']['#sorted'] = FALSE;
  $weight = $variables['page']['header']['usericonheader']['#weight'] ?? +14;
  $route = \Drupal::languageManager()->getCurrentLanguage()->getId() == 'en'
    ? 'piv_base.google_search_en'
    : 'piv_base.google_search_fr';
  $url = Url::fromRoute($route)->toString();
  $variables['page']['header']['search_icon'] = [
    '#markup' => "<a href='{$url}' class='search-icon'><svg width='27' height='27' viewBox='0 0 27 27' fill='none' stroke='white' stroke-width='1' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'> <circle cx='9.57' cy='9.57' r='9.07'></circle> <line x1='15.98' y1='15.98' x2='26.5' y2='26.5'></line> </svg>
</a>",
    '#weight' => $weight - 0.1,
    '#allowed_tags' => ['svg', 'path', 'a', 'circle', 'line'],
  ];
  $weight = $variables['page']['primary_menu']['useraccountmenu']['#weight'] ?? -10;
  $variables['page']['primary_menu']['#sorted'] = FALSE;
  $variables['page']['primary_menu']['search_icon'] = [
    '#markup' => "<a href='{$url}' class='search-icon'><svg width='27' height='27' viewBox='0 0 27 27' fill='none' stroke='white' stroke-width='1' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'> <circle cx='9.57' cy='9.57' r='9.07'></circle> <line x1='15.98' y1='15.98' x2='26.5' y2='26.5'></line> </svg>
</a>",
    '#weight' => $weight - 0.1,
    '#allowed_tags' => ['svg', 'path', 'a', 'circle', 'line'],
  ];

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $favourites_label = $langcode === 'fr' ? 'Favoris' : 'My Favourites';
  $variables['page']['header']['poem_favourites'] = [
    '#markup' => '<div class="poem-favourites dropdown"><button id="favouritesButton" class="btn dropdown-toggle" type="button" aria-label="' . $favourites_label . '"><img src="/roulette/images/icons/heart-outline.png" alt="" height="28" width="31" class="poem-favourites-icon" /></button><div id="favouritesDropdown" class="dropdown-menu" hidden><h4>' . $favourites_label . '</h4><hr><ul id="favouritePoems"></ul></div></div>',
    '#weight' => -13,
    '#allowed_tags' => ['div', 'button', 'h4', 'hr', 'ul', 'img', 'span'],
  ];

  $variables['#attached']['library'][] = 'lvp_barrio/poem-favourites';

  $account = \Drupal::currentUser();
  $poem_favourites_settings = [
    'lang' => $langcode,
    'uid' => (int) $account->id(),
    'emptyEn' => [
      'Find a poem you like.',
      'Click its heart to add it to My Favourites.',
      'To view My Favourites, click this heart.',
    ],
    'emptyFr' => [
      'Trouvez un poème que vous aimez.',
      'Ensuite, cliquez sur le cœur à côté du poème pour l&rsquo;ajouter à vos favoris.',
      'Pour voir vos favoris, cliquez sur le cœur dans la barre de navigation.',
    ],
  ];

  if (!$account->isAnonymous()) {
    $user = User::load($account->id());
    if ($user) {
      $poem_favourites_settings['favourites'] = PoemFavouritesStorage::load($user);
      $poem_favourites_settings['apiUrl'] = '/api/poem-favourites';
      $poem_favourites_settings['csrfToken'] = \Drupal::csrfToken()->get(PoemFavouritesController::CSRF_CONTEXT);
    }
  }

  $variables['#attached']['drupalSettings']['poemFavourites'] = $poem_favourites_settings;
}

/**
 * Implements hook_preprocess_page() for page.html.twig.
 */
function lvp_barrio_preprocess_page__front(array &$variables) {
  $variables['slideshow'] = views_embed_view('home_page_slider_fca', 'block_1');
  $variables['flyingblocks1'] = views_embed_view('home_page_slider_fca', 'block_2');
  $variables['flyingblocks2'] = views_embed_view('home_page_slider_fca', 'block_3');
  $variables['flyingblocks3'] = views_embed_view('home_page_slider_fca', 'block_4');
  $variables['flyingblocks4'] = views_embed_view('home_page_slider_fca', 'block_5');
}

/**
 * Implemets hook_preprocess_html().
 */
function lvp_barrio_preprocess_html(array &$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  switch ($route_name) {
    case 'piv_contest_judging_session.judge_for_accuracy.recitations_list':
    case 'piv_contest_judging_session.start_judging':
    case 'piv_contest_judging_session.read_poems':
    case 'piv_contest_judging_session.mark_poem_as_read':
    case 'piv_contest_judging_session.judge_recitations':
    case 'piv_contest_judging_session.judge_for_accuracy':
    case 'piv_contest_judging_session.judge_for_accuracy.recitations_list':
    case 'piv_contest_judging_session.judge_for_accuracy.judge_competition_entry':
      $variables['attributes']['class'][] = 'judging-page';
      break;

  }
}

/**
 * Implements hook_css_alter().
 */
function lvp_barrio_css_alter(&$css, \Drupal\Core\Asset\AttachedAssetsInterface $assets, \Drupal\Core\Language\LanguageInterface $language) {
  // Remove gin theme css from non admin pages.
  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    unset($css['themes/contrib/gin/dist/css/theme/dialog.css']);
  }
}

/**
 * Implements hook_js_alter().
 */
function lvp_barrio_js_alter(&$javascript, \Drupal\Core\Asset\AttachedAssetsInterface $assets, \Drupal\Core\Language\LanguageInterface $language) {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  foreach (array_keys($javascript) as $path) {
    if (str_contains($path, 'themes/contrib/gin/')) {
      unset($javascript[$path]);
    }
  }
}
