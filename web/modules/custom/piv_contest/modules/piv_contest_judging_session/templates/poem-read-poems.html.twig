<div{{ attributes.addClass('node--type-poem') }}>
  {% if content %}
    <header>
      <div class="poem-read__back">
        {{ content.back }}
      </div>
      <div class="poem-read__evaluated">
        {{ content.poems_read }}
      </div>
      <h2 class="poem-read__title">
        {{ content.title }}
      </h2>
      {% if content.author is not null %}
        <div class="poem-read__author block-views">
          {{ content.author }}
        </div>
      {% endif %}
    </header>
    
    {{ content.node }}
    
    <div class="poem-read__container block-field-blocknodepoembody">
      {% if content.field_epigraph is not null %}
        <div class="recitation-read__epigraph block-layout-builder">
          {{ content.field_epigraph }}
        </div>
      {% endif %}
      <div class="recitation-read__body">
        {{ content.description }}
      </div>
      <div class="poem-read__next">{{ content.read_next }}</div>
    </div>
    <footer>
      <div class="poem-read__later">{{ content.read_later }}</div>
    </footer>
  {% endif %}
</div>
