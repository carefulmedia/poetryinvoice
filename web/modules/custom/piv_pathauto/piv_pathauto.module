<?php

/**
 * @file
 * Primary module hooks for PIV Pathauto module.
 */

use Drupal\pathauto\PathautoPatternInterface;

/**
 * Implements hook_pathauto_pattern_alter().
 */
function piv_pathauto_pathauto_pattern_alter(PathautoPatternInterface $pattern, array $context) {
  if ($context['module'] == 'user' && !empty($context['data']['user'])) {
    $user = $context['data']['user'];
    if ($user->hasRole('poet')) {
      if ($user->getPreferredLangcode() == 'fr') {
        $pattern->setPattern('poemes/poetes/[user:name]');
      }
      else {
        $pattern->setPattern('poems/poets/[user:name]');
      }
    }
  }
}
