<?php

/**
 * @file
 * Install, update and uninstall functions for PIV Futureverse.
 */

/**
 * Install editable thank-you messages for public submissions.
 */
function piv_futureverse_update_9001() {
  $config = \Drupal::configFactory()->getEditable('piv_futureverse.submission_messages');
  if ($config->isNew()) {
    $config->setData([
      'langcode' => 'en',
    ] + piv_futureverse_submission_message_defaults())->save(TRUE);
  }

  if (!\Drupal::languageManager()->getLanguage('fr')) {
    return;
  }
  $french = \Drupal::languageManager()->getLanguageConfigOverride('fr', 'piv_futureverse.submission_messages');
  if ($french->isNew()) {
    $french->setData([
      'journal_poem' => "Merci d'avoir soumis votre poème !",
      'futureverse_application' => "Merci d'avoir soumis votre candidature !",
      'poet_bio' => "Merci d'avoir soumis votre bio !",
    ])->save();
  }
}

/**
 * Install editable field group labels for the student application form.
 */
function piv_futureverse_update_9002() {
  $config = \Drupal::configFactory()->getEditable('piv_futureverse.futureverse_application_student_field_groups');
  if ($config->isNew()) {
    $config->set('langcode', 'en');
    foreach (piv_futureverse_student_field_group_defaults() as $group_id => $values) {
      $keys = piv_futureverse_student_field_group_storage_keys($group_id);
      $config->set($keys['label'], $values['label']);
      $config->set($keys['description'], $values['description']);
    }
    $config->save(TRUE);
  }
}

/**
 * Flatten nested field group config for the configuration translation UI.
 */
function piv_futureverse_update_9003() {
  $config = \Drupal::configFactory()->getEditable('piv_futureverse.futureverse_application_student_field_groups');
  $data = $config->getRawData();
  if (empty($data['groups']) || !is_array($data['groups'])) {
    return;
  }
  foreach ($data['groups'] as $group_id => $values) {
    if (!is_array($values)) {
      continue;
    }
    $keys = piv_futureverse_student_field_group_storage_keys($group_id);
    $config->set($keys['label'], $values['label'] ?? '');
    $config->set($keys['description'], $values['description'] ?? '');
  }
  $config->clear('groups')->save();

  if (!\Drupal::languageManager()->getLanguage('fr')) {
    return;
  }
  $override = \Drupal::languageManager()->getLanguageConfigOverride('fr', 'piv_futureverse.futureverse_application_student_field_groups');
  $override_data = $override->getRawData();
  if (empty($override_data['groups']) || !is_array($override_data['groups'])) {
    return;
  }
  foreach ($override_data['groups'] as $group_id => $values) {
    if (!is_array($values)) {
      continue;
    }
    $keys = piv_futureverse_student_field_group_storage_keys($group_id);
    $override->set($keys['label'], $values['label'] ?? '');
    $override->set($keys['description'], $values['description'] ?? '');
  }
  $override->clear('groups')->save();
}

/**
 * Add fifth-poem and monthly-limit journal submission messages.
 */
function piv_futureverse_update_9004() {
  $defaults = piv_futureverse_submission_message_defaults();
  $config = \Drupal::configFactory()->getEditable('piv_futureverse.submission_messages');
  foreach (['journal_poem_fifth', 'journal_poem_limit'] as $key) {
    $current = $config->get($key);
    if (!is_string($current) || trim($current) === '') {
      $config->set($key, $defaults[$key]);
    }
  }
  $config->save();

  if (!\Drupal::languageManager()->getLanguage('fr')) {
    return;
  }
  $french = \Drupal::languageManager()->getLanguageConfigOverride('fr', 'piv_futureverse.submission_messages');
  $french_defaults = [
    'journal_poem_fifth' => 'Vous êtes extraordinaire ! Vous avez soumis 5 poèmes ce mois-ci ! Revenez le mois prochain pour en soumettre d’autres.',
    'journal_poem_limit' => 'Désolé, vous avez atteint votre limite de 5 poèmes pour ce mois. Veuillez soumettre vos poèmes le mois prochain.',
  ];
  foreach ($french_defaults as $key => $value) {
    $current = $french->get($key);
    if (!is_string($current) || trim($current) === '') {
      $french->set($key, $value);
    }
  }
  $french->save();
}
