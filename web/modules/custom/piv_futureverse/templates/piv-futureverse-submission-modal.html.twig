<div class="modal fade" id="piv-futureverse-submission-modal" tabindex="-1" aria-labelledby="piv-futureverse-submission-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5" id="piv-futureverse-submission-modal-title">{{ 'Thank you'|t }}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|t }}"></button>
      </div>
      <div class="modal-body">
        {{ message }}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{ 'OK'|t }}</button>
      </div>
    </div>
  </div>
</div>
