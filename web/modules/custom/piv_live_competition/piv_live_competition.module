<?php

/**
 * @file
 * Primary module hooks for PIV Live Competition module.
 */

use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
use Drupal\Component\Plugin\Exception\PluginNotFoundException;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;

// Error message constants.
const PIV_LIVE_COMPETITION_ERROR_ALREADY_STARTED = 'This competition has already begun. You cannot add new entries to it.';
const PIV_LIVE_COMPETITION_ERROR_MAX_ENTRIES = 'Your school has reached the maximum number of entries (%s) for this competition.';
const PIV_LIVE_COMPETITION_ERROR_NO_SCHOOL = 'You must be assigned to a school to create entries for this competition.';
const PIV_LIVE_COMPETITION_ERROR_NOT_INVITED = 'You can only create entries for competitions your school is invited to.';
const PIV_LIVE_COMPETITION_ERROR_INVALID_COMPETITION = 'The provided competition is invalid or does not exist.';
const PIV_LIVE_COMPETITION_ERROR_COMPETITION_NOT_FOUND = 'The provided competition does not exist.';

/**
 * Implements hook_ENTITY_TYPE_access().
 *
 * Alter access permissions for editing/deleting live competition entries depending on the status of their
 * parent competition.
 *
 * @see \hook_ENTITY_TYPE_access()
 */
function piv_live_competition_node_access(
  EntityInterface $entity,
  $operation,
  AccountInterface $account,
): AccessResultInterface {
  // Check the entity bundle.
  if ($entity->bundle() !== 'team_regionals_entry') {
    return AccessResult::neutral();
  }

  // Only act on edit/delete operations.
  if (!in_array($operation, ['update', 'delete'])) {
    return AccessResult::neutral();
  }

  // Admins can bypass these rules.
  if ($account->hasRole('administrator')) {
    return AccessResult::neutral();
  }

  // Get the parent competition.
  $competition = $entity->get('field_contest_association')->entity;
  if (!$competition || $competition->bundle() !== 'competition') {
    return AccessResult::neutral();
  }

  // If the competition has started, we should deny access.
  if (_piv_live_competition_has_competition_started($competition)) {
    return AccessResult::forbidden();
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node entities.
 *
 * We add custom validation logic to make sure 'team_regionals_entry' nodes can be created.
 *
 * @see \hook_ENTITY_TYPE_presave()
 *
 */
function piv_live_competition_node_presave(NodeInterface $node): void {
  if ($node->bundle() !== 'team_regionals_entry') {
    return;
  }

  $account = \Drupal::currentUser();

  if ($account->hasRole('administrator')) {
    return;
  }

  // Get the associated competition.
  // Validations only happen if a contest is associated.
  if (!$node->get('field_contest_association')->isEmpty()) {
    $competition = $node->get('field_contest_association')->entity;

    // Validate competition hasn't started.
    if (_piv_live_competition_has_competition_started($competition)) {
      throw new \RuntimeException(PIV_LIVE_COMPETITION_ERROR_ALREADY_STARTED);
    }

    // Validate max entries per school.
    if (_piv_live_competition_competition_is_maxed_out_for_teacher_school(
      $competition,
      $account,
      $node->isNew() ? NULL : $node->id(),
    )) {
      throw new \RuntimeException(PIV_LIVE_COMPETITION_ERROR_MAX_ENTRIES);
    }

    // Validate invited schools.
    if (!_piv_live_competition_teacher_school_is_invited_to_competition($competition, $account)) {
      throw new \RuntimeException(PIV_LIVE_COMPETITION_ERROR_NOT_INVITED);
    }
  }
}

/**
 * Implements hook_form_alter().
 *
 * Filters competition options and adds validation for team_regionals_entry form.
 *
 * @see \hook_form_alter()
 */
function piv_live_competition_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  if (!in_array($form_id, ['node_team_regionals_entry_form', 'node_team_regionals_entry_edit_form'])) {
    return;
  }

  $account = \Drupal::currentUser();

  // Don't apply to admins.
  if ($account->hasRole('administrator')) {
    return;
  }

  // Handle the request parameter from the prepopulate module.
  $request_query_prepopulate = \Drupal::request()->query->all('edit');
  if (!empty($request_query_prepopulate)) {
    $competition_id = $request_query_prepopulate['field_contest_association']['widget'] ?? '';

    if (empty($competition_id)) {
      throw new NotFoundHttpException(PIV_LIVE_COMPETITION_ERROR_INVALID_COMPETITION);
    }

    // Load and validate the competition.
    $competition_node = _piv_live_competition_load_competition($competition_id);
    if (!$competition_node) {
      throw new NotFoundHttpException(PIV_LIVE_COMPETITION_ERROR_COMPETITION_NOT_FOUND);
    }

    $teacher_school = _piv_live_competition_get_teacher_school($account);
    if (!$teacher_school) {
      throw new AccessDeniedHttpException(PIV_LIVE_COMPETITION_ERROR_NO_SCHOOL);
    }

    // Validate competition hasn't started.
    if (_piv_live_competition_has_competition_started($competition_node)) {
      throw new AccessDeniedHttpException(PIV_LIVE_COMPETITION_ERROR_ALREADY_STARTED);
    }

    // Validate max entries.
    $current_entry_id = $form_state->getFormObject()->getEntity()->isNew()
      ? NULL
      : $form_state->getFormObject()->getEntity()->id();

    if (_piv_live_competition_competition_is_maxed_out_for_teacher_school(
      $competition_node,
      $account,
      $current_entry_id,
    )) {
      throw new AccessDeniedHttpException(PIV_LIVE_COMPETITION_ERROR_MAX_ENTRIES);
    }

    if (!_piv_live_competition_teacher_school_is_invited_to_competition($competition_node, $account)) {
      throw new AccessDeniedHttpException(PIV_LIVE_COMPETITION_ERROR_NOT_INVITED);
    }

    // If all is good with the prefill, we can hide the field to make sure it isn't changed.
    $form['field_contest_association']['widget']['#disabled'] = TRUE;
  }

  // Filter the competition options for teachers based on invited schools.
  if (isset($form['field_contest_association']['widget']['#options'])) {
    $teacher_school = _piv_live_competition_get_teacher_school($account);

    if ($teacher_school) {
      $allowed_competitions = _piv_live_competition_get_allowed_competitions($teacher_school);

      // Filter the options to only show allowed competitions.
      foreach ($form['field_contest_association']['widget']['#options'] as $competition_id => $label) {
        // Skip special options like '_none'.
        if (is_string($competition_id) && str_starts_with($competition_id, '_')) {
          continue;
        }

        // Remove competitions the teacher isn't allowed to access.
        if (!in_array($competition_id, $allowed_competitions, FALSE)) {
          unset($form['field_contest_association']['widget']['#options'][$competition_id]);
        }
      }
    }
  }

  $form['#validate'][] = '_piv_live_competition_validate_competition_access';
}

/**
 * Custom validation handler for team_regionals_entry forms.
 */
function _piv_live_competition_validate_competition_access(&$form, FormStateInterface $form_state): void {
  $account = \Drupal::currentUser();

  if ($account->hasRole('administrator')) {
    return;
  }

  $competition_nid = $form_state->getValue(['field_contest_association', 0, 'target_id']);

  if (!$competition_nid) {
    return;
  }

  $competition_node = _piv_live_competition_load_competition($competition_nid);

  if (!$competition_node) {
    return;
  }

  // Active round check.
  if (_piv_live_competition_has_competition_started($competition_node)) {
    $form_state->setErrorByName('field_contest_association', t(PIV_LIVE_COMPETITION_ERROR_ALREADY_STARTED));
    return;
  }

  // Get the current entry ID if editing.
  $current_entry_id = _piv_live_competition_get_current_entry_id($form_state);

  // Validate max entries.
  if (_piv_live_competition_competition_is_maxed_out_for_teacher_school(
    $competition_node,
    $account,
    $current_entry_id,
  )) {
    $form_state->setErrorByName('field_contest_association', t(PIV_LIVE_COMPETITION_ERROR_MAX_ENTRIES));
    return;
  }

  // Validate invited schools.
  if (!_piv_live_competition_teacher_school_is_invited_to_competition($competition_node, $account)) {
    $form_state->setErrorByName('field_contest_association', PIV_LIVE_COMPETITION_ERROR_NOT_INVITED);
  }
}

/**
 * Helper function to check if competition has started.
 *
 * @param \Drupal\node\NodeInterface $competition
 *   The competition node.
 *
 * @return bool
 *   TRUE if competition has started, FALSE otherwise.
 */
function _piv_live_competition_has_competition_started(NodeInterface $competition): bool {
  return (int) $competition->get('field_active_round')->value !== 0;
}

/**
 * Helper function to load a competition node.
 *
 * @param int $competition_id
 *   The competition node ID.
 *
 * @return \Drupal\node\NodeInterface|null
 *   The competition node or NULL if not found.
 */
function _piv_live_competition_load_competition(int $competition_id): ?NodeInterface {
  try {
    $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadByProperties([
      'nid' => $competition_id,
      'type' => 'competition',
    ]);
  } catch (InvalidPluginDefinitionException|PluginNotFoundException $e) {
    return NULL;
  }

  return $nodes ? reset($nodes) : NULL;
}

/**
 * Helper function to get invited school IDs from a competition.
 *
 * @param \Drupal\node\NodeInterface $competition
 *   The competition node.
 *
 * @return array
 *   Array of invited school IDs.
 */
function _piv_live_competition_get_invited_school_ids(NodeInterface $competition): array {
  if (!$competition->hasField('field_invited_schools')) {
    return [];
  }

  $invited_schools = $competition->get('field_invited_schools')->referencedEntities();

  if (empty($invited_schools)) {
    return [];
  }

  return array_map(static fn($school) => $school->id(), $invited_schools);
}

/**
 * Helper function to get the current entry ID from form state.
 *
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 *
 * @return int|null
 *   The entry ID or NULL if new entry.
 */
function _piv_live_competition_get_current_entry_id(FormStateInterface $form_state): ?int {
  $form_object = $form_state->getFormObject();
  if (method_exists($form_object, 'getEntity')) {
    $entity = $form_object->getEntity();
    if (!$entity->isNew()) {
      return $entity->id();
    }
  }

  return NULL;
}

/**
 * Helper function to get the school from an entry.
 *
 * An entry's school is the school of the person that created the entry.
 *
 * @return NodeInterface|null
 *   The school node of the author that created the entry.
 */
function _piv_live_competition_get_entry_school(NodeInterface $entry): ?NodeInterface {
  $author = $entry->get('uid')->entity;
  if (!$author) {
    return NULL;
  }
  return _piv_live_competition_get_teacher_school($author);
}

/**
 * Checks if a given competition is maxed out for a teacher's school.
 *
 * @param NodeInterface $competition
 *   The competition node.
 * @param AccountInterface $teacher
 *   The user account.
 * @param int|null $exclude_entry_id
 *   Optional entry ID to exclude from count.
 *
 * @return bool
 *   Return TRUE if no more entries can be created for this school for this competition.
 */
function _piv_live_competition_competition_is_maxed_out_for_teacher_school(
  NodeInterface $competition,
  AccountInterface $teacher,
  ?int $exclude_entry_id = NULL,
): bool {
  $max_entries_per_school = $competition->get('field_maximum_entries_per_school')->value;

  if (empty($max_entries_per_school) || $max_entries_per_school <= 0) {
    return FALSE;
  }

  $teacher_school = _piv_live_competition_get_teacher_school($teacher);

  if (!$teacher_school) {
    return FALSE;
  }

  try {
    $existing_entries_count = _piv_live_competition_count_school_entries(
      $competition->id(),
      $teacher_school->id(),
      $exclude_entry_id
    );
  } catch (InvalidPluginDefinitionException|PluginNotFoundException $e) {
    return TRUE;
  }

  return $existing_entries_count >= $max_entries_per_school;
}

/**
 * Checks if the teacher's school is invited.
 *
 * "Invited" in this case means that the school is teacher is assigned to is in the 'field_invited_schools'
 * field of the competition.
 *
 * If the field is empty, then all schools are technically invited.
 *
 * @param \Drupal\node\NodeInterface $competition
 *   The competition node.
 * @param \Drupal\Core\Session\AccountInterface $teacher
 *   The teacher account.
 *
 * @returns bool
 *   Returns TRUE if the given teacher's school has access via invitation or the competition has no invited schools.
 *   Returns FALSE otherwise.
 */
function _piv_live_competition_teacher_school_is_invited_to_competition(
  NodeInterface $competition,
  AccountInterface $teacher,
): bool {
  $invited_school_ids = _piv_live_competition_get_invited_school_ids($competition);

  // If there are no invited schools, then basically every school is invited.
  if (empty($invited_school_ids)) {
    return TRUE;
  }

  $teacher_school = _piv_live_competition_get_teacher_school($teacher);

  if (!$teacher_school) {
    return FALSE;
  }

  if (!in_array($teacher_school->id(), $invited_school_ids, TRUE)) {
    return FALSE;
  }

  return TRUE;
}

/**
 * Helper function to get allowed competitions for a school.
 *
 * @param \Drupal\node\NodeInterface $school
 *   The school node.
 *
 * @return array
 *   Array of competition IDs that the school can access.
 *
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 */
function _piv_live_competition_get_allowed_competitions(NodeInterface $school): array {
  $teacher_school_id = $school->id();
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  $competitions_without_invited_schools = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'competition')
    ->condition('field_active_round', 0)
    ->notExists('field_invited_schools')
    ->execute();

  $competitions_with_teacher_school_invited = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'competition')
    ->condition('field_active_round', 0)
    ->condition('field_invited_schools', $teacher_school_id)
    ->execute();

  // Merge and return unique IDs.
  return array_values(array_unique(array_merge($competitions_without_invited_schools, $competitions_with_teacher_school_invited)));
}

/**
 * Helper function to get a teacher's school.
 *
 * @param AccountInterface $account
 *   The user account.
 *
 * @return \Drupal\node\NodeInterface|null
 *   The school node or NULL if not found.
 */
function _piv_live_competition_get_teacher_school(AccountInterface $account): ?NodeInterface {
  try {
    $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
  } catch (InvalidPluginDefinitionException|PluginNotFoundException $e) {
    return NULL;
  }

  if ($user && $user->hasField('field_school') && !$user->get('field_school')->isEmpty()) {
    return $user->get('field_school')->entity;
  }

  return NULL;
}

/**
 * Helper function to count team_regionals_entry nodes for a school and competition.
 *
 * @param int $competition_id
 *   The competition node ID.
 * @param int $school_id
 *   The school node ID.
 * @param int|null $exclude_entry_id
 *   Optional entry ID to exclude from the count (for editing existing entries).
 *
 * @return int
 *   The count of entries.
 *
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 */
function _piv_live_competition_count_school_entries(int $competition_id, int $school_id, ?int $exclude_entry_id = NULL): int {
  // Get all users (teachers) at this school.
  $user_query = \Drupal::entityTypeManager()->getStorage('user')->getQuery();
  $teacher_uids = $user_query->condition('field_school', $school_id)
    ->accessCheck(FALSE)
    ->execute();

  if (empty($teacher_uids)) {
    return 0;
  }

  // Count entries for this competition from teachers at this school.
  $entry_query = \Drupal::entityTypeManager()->getStorage('node')->getQuery();
  $entry_query->condition('type', 'team_regionals_entry')
    ->condition('field_contest_association', $competition_id)
    ->condition('uid', $teacher_uids, 'IN')
    ->accessCheck(FALSE);

  // Exclude the current entry if editing.
  if ($exclude_entry_id !== NULL) {
    $entry_query->condition('nid', $exclude_entry_id, '<>');
  }

  return (int) $entry_query->count()->execute();
}
