<?php

/**
 * @file
 * Install, update and uninstall functions for the PIV base module.
 */

use Drupal\Component\Utility\Environment;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Set value to 'Allow poet visits for this school' field on schools.
 */
function piv_base_update_9001() {
  Environment::setTimeLimit(0);
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $node_storage->getQuery()
    ->accessCheck(FALSE)
    ->notExists('field_allow_poet_visits_school')
    ->condition('type', 'school')
    ->execute();
  $cant_create_nids = [22469, 22470];
  foreach ($nids as $nid) {
    $node = $node_storage->load($nid);
    $node->field_allow_poet_visits_school = in_array($nid, $cant_create_nids) ? 0 : 1;
    $node->save();
  }

}

/**
 * Replacing the plain text field_poem_reason for a formatted-long with all data.
 */
function piv_base_update_9002() {
  $database = \Drupal::database();
  $entityType = 'node';
  $fieldName = 'field_poem_reason';
  $table = $entityType . '__' . $fieldName;
  $currentRows = NULL;
  $newFieldsList = [];
  $fieldStorage = FieldStorageConfig::loadByName($entityType, $fieldName);

  if (is_null($fieldStorage)) {
    return;
  }

  // Get all current data from DB.
  if ($database->schema()->tableExists($table)) {
    $currentRows = $database->select($table, 'n')
      ->fields('n')
      ->execute()
      ->fetchAll();
  }

  // Use existing field config for new field.
  foreach ($fieldStorage->getBundles() as $bundle => $label) {
    $field = FieldConfig::loadByName($entityType, $bundle, $fieldName);
    $newField = $field->toArray();
    $newField['field_type'] = 'text_long';
    $newField['settings'] = [];
    $newFieldsList[] = $newField;
  }

  // Deleting field storage which will also delete bundles(fields).
  $newFieldStorage = $fieldStorage->toArray();
  $newFieldStorage['type'] = 'text_long';
  $newFieldStorage['settings'] = [];

  // Delete the old field.
  $fieldStorage->delete();

  // Purge field data. Important to create the new field with the same name.
  field_purge_batch(40);

  // Create new field storage.
  $newFieldStorage = FieldStorageConfig::create($newFieldStorage);
  $newFieldStorage->save();

  // Create new fields.
  foreach ($newFieldsList as $nfield) {
    $nfieldConfig = FieldConfig::create($nfield);
    $nfieldConfig->save();
  }

  // Restore existing data in new table.
  if (!is_null($currentRows)) {
    foreach ($currentRows as $row) {
      $database->insert($table)
        ->fields((array) $row)
        ->execute();
    }
  }
}

/**
 * Use CSS backgrounds for related poet teasers so Google prefers the main photo.
 */
function piv_base_update_9003() {
  _piv_base_configure_poet_listing_teaser_images();
}

/**
 * Fix related poet teaser tokens (field order and plain-text name).
 */
function piv_base_update_9004() {
  _piv_base_configure_poet_listing_teaser_images();
}

/**
 * Updates the related poets view to avoid competing <img> tags in search results.
 */
function _piv_base_configure_poet_listing_teaser_images(): void {
  $config = \Drupal::configFactory()->getEditable('views.view.user_listing_index_pages');
  if ($config->isNew()) {
    return;
  }

  $fields = $config->get('display.block_7.display_options.fields');
  if (empty($fields['user_picture']) || empty($fields['view_user'])) {
    return;
  }

  unset($fields['picture_url']);

  $fields['user_picture']['type'] = 'image_url';
  $fields['user_picture']['settings'] = [
    'image_style' => 'focal_point_700_x_',
  ];
  $fields['user_picture']['exclude'] = TRUE;

  $fields['plain_name'] = $fields['name'];
  $fields['plain_name']['id'] = 'plain_name';
  $fields['plain_name']['type'] = 'string';
  $fields['plain_name']['exclude'] = TRUE;
  $fields['plain_name']['alter']['alter_text'] = FALSE;
  $fields['plain_name']['alter']['text'] = '';

  $fields['view_user']['alter']['text'] = <<<'TWIG'
<div class="index-views mixtape content-index" data-nosnippet="true">

    <a href="{{ view_user }}" class="area-link" style="display:block">

            <div class="image poet-related-teaser-image" style="background-image: url('{{ user_picture }}');" role="img" aria-label="{{ plain_name }}"></div>
            <div class="content">
              		<h3>{{ plain_name }}</h3>
              		<p>{{ field_user_bio }}</p>
            </div>

    </a>
</div>
TWIG;

  // Views only exposes tokens from fields listed before the rewriting field.
  $fields = array_merge(
    [
      'user_picture' => $fields['user_picture'],
      'plain_name' => $fields['plain_name'],
    ],
    array_diff_key($fields, [
      'user_picture' => TRUE,
      'plain_name' => TRUE,
    ]),
  );

  $config->set('display.block_7.display_options.fields', $fields);
  $config->save(TRUE);
  \Drupal::service('plugin.manager.views.display')->clearCachedDefinitions();
}
