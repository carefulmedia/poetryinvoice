{% if id is not null %}
  <div class="contest-video youtube-container--responsive">
    <iframe width="100%" height="100%" id="youtube-{{ id }}"
      src="https://www.youtube.com/embed/{{ id }}?enablejsapi=1" frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen></iframe>
  </div>
{% endif %}
