<?php

/**
 * @file
 * Primary module hooks for PIV Base module.
 */

use Drupal\Component\Utility\UrlHelper;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;
use Symfony\Component\HttpFoundation\RedirectResponse;

/**
 * Implements hook_user_format_name_alter().
 */
function piv_base_user_format_name_alter(&$name, AccountInterface $account) {
  if ($account->isAuthenticated()) {
    $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
    if ($user) {
      $first_name = $user->piv_teacher_first_name->value;
      $last_name = $user->piv_teacher_last_name->value;
      if ($first_name || $last_name) {
        $name = trim("$first_name $last_name");
      }
    }
  }
}

/**
 * Implements hook_entity_form_mode_alter().
 */
function piv_base_entity_form_mode_alter(&$form_mode, EntityInterface $entity) {
  // Change the poet school visit form nodes if they are created by a teacher
  // that is not an admin.
  if ($entity->getEntityTypeId() == 'node' && $entity->bundle() == 'pal_pir_school_visit') {
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if ($current_user->id() != 1
    && !in_array('superadmin', $roles)
    && in_array('teacher', $roles)) {
      $form_mode = 'teacher';
    }
  }
  if ($entity->getEntityTypeId() == 'user') {
    $current_user = \Drupal::currentUser();
    if (!$current_user->hasPermission('administer site configuration')) {
      if ($entity->hasRole('teacher')) {
        $form_mode = 'teacher_edit';
      }
      elseif ($entity->hasRole('poet_network')) {
        $form_mode = 'poet_network';
      }
      // Else, just go with default.
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function piv_base_preprocess_menu_local_tasks(&$variables) {
  $current_user = $variables['user'];
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() == 'entity.node.edit_form') {
    $node = $route->getParameter('node');
    if ($node->bundle() == 'pal_pir_school_visit') {
      $roles = $current_user->getRoles();
      if ($current_user->id() != 1
      && !in_array('superadmin', $roles)
      && in_array('teacher', $roles)) {
        // Disable secondary menu on poet visit school node if user is not
        // admin.
        unset($variables['secondary']['form_mode_manager.entities:form_mode_manager.node.teacher.task_tab']);
        if (count($variables['secondary']) == 1) {
          $variables['secondary'] = [];
        }
      }
    }
    return;
  }

  // Disable form modes for users if not admin.
  if (!$current_user->hasPermission('administer site configuration')) {
    unset($variables['primary']['form_mode_manager.entities:form_mode_manager.user.poet_network.task_tab']);
    unset($variables['primary']['form_mode_manager.entities:form_mode_manager.user.poets.task_tab']);
    unset($variables['primary']['form_mode_manager.entities:form_mode_manager.user.teacher_edit.task_tab']);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function piv_base_form_user_form_alter(&$form, FormStateInterface $form_state) {
  // Prevent users from removing the judge role.
  if (isset($form['account']['roles']) && isset($form['account']['roles']['#options']['judge'])) {
    if (in_array('judge', $form['account']['roles']['#default_value'])) {
      $form['account']['roles']['judge']['#disabled'] = TRUE;
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function piv_base_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (in_array($form_id, [
    'paragraph_poet_questionnaire_form',
    'paragraph_teacher_questionnaire_form',
  ])) {
    $form['actions']['submit']['#submit'][] = 'piv_base_form_survey_custom_submit';
  }

  if (in_array($form_id, [
    'node_pal_pir_school_visit_form',
    'node_pal_pir_school_visit_edit_form',
  ])) {
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if ($current_user->id() != 1 && !in_array('superadmin', $roles)) {
      $form['langcode']['#access'] = FALSE;
    }

    $form_display = $form_state->getStorage()['form_display'];
    if ($form_display && $form_display->getMode() == 'teacher') {
      $form['field_preferred_poet_s_']['#states'] = [
        'visible' => [
          ':input[name="field_do_you_have_any_poet_prefe[value]"]' => ['checked' => TRUE],
        ],
      ];
      $form['field_date_and_start_time']['#states'] = [
        'visible' => [
          ':input[name="field_preferred_date[value]"]' => ['checked' => TRUE],
        ],
      ];
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function piv_base_node_presave(EntityInterface $entity) {
  if ($entity->bundle() == 'pal_pir_school_visit') {
    // Title is the node created time or current time in case of new node.
    $entity->title = $entity->created->value ?? \Drupal::time()->getCurrentTime();
  }
  elseif ($entity->bundle() == 'poem') {
    $entity->title = str_replace("'", "’", $entity->label());
  }

  if ($entity->hasField('field_plain_title')) {
    $entity->field_plain_title = trim(piv_base_transliterate_string(strip_tags($entity->label())));
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * If the source changed in remote video, remove the media title, so oEmbed will
 * update it with data from the source url. Otherwise the media will retain the
 * original title when updating a url.
 */
function piv_base_media_presave(EntityInterface $entity) {
  // @see Drupal\media\Entity\Media::hasSourceFieldChanged()
  if ($entity->bundle() == 'remote_video') {
    $source = $entity->getSource();
    $has_source_field_changed = isset($entity->original) && $source->getSourceFieldValue($entity) !== $source->getSourceFieldValue($entity->original);
    if ($has_source_field_changed) {
      $entity->setName(NULL);
    }
  }
}

/**
 * Implements hook_entity_create_access().
 */
function piv_base_entity_create_access(AccountInterface $account, array $context, $entity_bundle) {
  // Prevent teachers with no schools from creating school visits.
  $entity_type_id = $context['entity_type_id'] ?? NULL;
  if ($entity_type_id == 'node' && $entity_bundle == 'pal_pir_school_visit') {
    $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
    $school_can_create_visit = $user->field_school->entity->field_allow_poet_visits_school->value == 1;
    if (!$user || !$school_can_create_visit) {
      return AccessResult::forbidden();
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_theme().
 */
function piv_base_theme($existing, $type, $theme, $path) {
  return [
    'piv_welcome_modal' => [
      'render element' => 'content',
      'variables' => [
        'menu' => NULL,
        'form' => NULL,
      ],
    ],
    'piv_back_link' => [
      'render element' => 'content',
      'variables' => [
        'link' => NULL,
      ],
    ],
    // Custom theme to render youtube videos without oembed and with jsonapi
    // enabled.
    'piv_youtube' => [
      'render element' => 'content',
      'variables' => [
        'url' => NULL,
        'id' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_page().
 */
function piv_base_preprocess_html(&$variables) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['langcode'] = $langcode;

  $route = \Drupal::routeMatch();
  if ($route->getRouteName() == 'entity.node.canonical') {
    if ($node = $route->getParameter('node')) {
      // If there is no translation for the current node to the current site
      // language, redirect the user to the original node language url.
      if (!$node->hasTranslation($langcode)) {
        $default_language = $node->language();
        // Non-system language.
        if (!$default_language->isLocked()) {
          $url = $node->toUrl();
          $url->setOption('language', $default_language);
          $response = new RedirectResponse($url->toString());
          $response->send();
          return;
        }
      }
    }
  }

  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    $entity_type_manager = \Drupal::entityTypeManager();
    $block = $entity_type_manager->getStorage('block')->load('useraccountmenu');
    $variables['page_bottom'][] = [
      '#theme' => 'piv_welcome_modal',
      '#menu' => $entity_type_manager->getViewBuilder('block')->view($block),
      '#form' => \Drupal::formBuilder()->getForm('\Drupal\piv_base\Form\PivWelcomeModal'),
    ];
    $variables['page_bottom']['#attached']['library'][] = 'piv_base/redirect_after_login';
  }
}

/**
 * Custom submit handler for paragraph surveys.
 */
function piv_base_form_survey_custom_submit($form, FormStateInterface $form_state) {
  $paragraph = $form_state->getFormObject()->getEntity();
  $node = $form_state->get('survey_paragraph_node') ?? $paragraph->getParentEntity();
  // If editing a paragraph that exists, the field_name will be empty. It is not
  // a problem since the node already references the paragraph.
  $field_name = $form_state->get('survey_paragraph_field');
  if ($node && $field_name && $paragraph) {
    $node->{$field_name} = $paragraph;
    $node->save();
  }
  if ($paragraph->bundle() == 'poet_questionnaire') {
    $form_state->setRedirect('piv_base.poet_survey_view', [
      'node' => $node->id(),
    ]);
  }
  elseif ($paragraph->bundle() == 'teacher_questionnaire') {
    $form_state->setRedirect('piv_base.teacher_survey_view', [
      'node' => $node->id(),
    ]);
  }

  \Drupal::messenger()->addMessage(t('The changes have been saved.'));
}

/**
 * Implements hook_preprocess_HOOK().
 */
function piv_base_preprocess_links__language_block(&$variables) {
  $route = \Drupal::routeMatch();
  $route_name = $route->getRouteName();
  if ($route_name == 'entity.node.canonical') {
    // If there is no translation, the language switcher should redirect the
    // user to the frontpage.
    if ($node = $route->getParameter('node')) {
      foreach ($variables['links'] as $langcode => &$link) {
        if (!$node->hasTranslation($langcode)) {
          // Language is already set in the link options.
          $link['link']['#url'] = Url::fromRoute('<front>');
        }
      }
    }
  }
  // Unset the links for the current language.
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  unset($variables['links'][$langcode]);
}

/**
 * Implements hook_page_attachments_alter().
 */
function piv_base_page_attachments_alter(array &$attachments) {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    // Do not alter favicon for admin routes.
    return;
  }

  global $base_path;
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $theme = \Drupal::theme()->getActiveTheme();
  $favicon = "{$base_path}{$theme->getPath()}/favicon-{$langcode}.ico";

  // Alter favicon to use translatable favicons.
  // Mimetype is hardcoded and will work for .ico, needs to be changed if
  // replaced by png or others.
  $attachments['#attached']['html_head_link'] = [];
  $attachments['#attached']['html_head_link'][][] = [
    'rel' => 'icon',
    'href' => UrlHelper::stripDangerousProtocols($favicon),
    'type' => 'image/vnd.microsoft.icon',
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function piv_base_preprocess_node(&$variables) {
  // Add a print button to all node types.
  global $base_path;
  $path = \Drupal::service('extension.list.module')->getPath('piv_base');
  $image_path = "{$base_path}{$path}/assets/print_icon.gif";
  $markup = Markup::create("<img src='{$image_path}' onclick='window.print()' class='print-icon' style='cursor: pointer;'>");
  $variables['print_button'] = [
    '#markup' => $markup,
  ];
}

/**
 * Implements hook_preprocess_piv_youtube().
 */
function template_preprocess_piv_youtube(&$variables) {
  if (!empty($variables['id'])) {
    return;
  }

  if (!empty($variables['url'])) {
    // Extract the id from a url.
    $regexp = '/(?im)\b(?:https?:\/\/)?(?:w{3}\.)?youtu(?:be)?\.(?:com|be)\/(?:(?:\??v=?i?=?\/?)|watch\?vi?=|watch\?.*?&v=|embed\/|)([A-Z0-9_-]{11})\S*(?=\s|$)/';
    preg_match($regexp, $variables['url'], $match);
    $id = $match[1] ?? NULL;
    if ($id) {
      $variables['id'] = $id;
    }
  }
}

/**
 * Transliterate a string.
 */
function piv_base_transliterate_string($string) {
  // Remove accents, etc.
  $string = \Drupal::transliteration()->removeDiacritics($string);
  // Remove everything that is not alphanumeric or space.
  return preg_replace('/[^A-Za-z0-9 ]/', '', $string);
}

/**
 * Implements hook_views_query_alter().
 */
function piv_contest_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'language_restricted_poems') {
    // This view is a entity reference view, code below alters the query on the
    // search string in a autocomplete to sanitize the values there, ignoring
    // any non alphanumeric or space character. Views get the searched string
    // from the route parameters directly (it is the $_GET['q']).
    foreach ($query->where as &$condition_group) {
      foreach ($condition_group['conditions'] as &$condition) {
        if (is_a($condition['field'], 'Drupal\Core\Database\Query\Condition')) {
          foreach ($condition['field']->conditions() as &$inner_condition) {
            if (is_array($inner_condition) && !empty($inner_condition['field'])) {
              if ($inner_condition['field'] == 'node__field_plain_title.field_plain_title_value') {
                $q = $inner_condition['value'];
                $inner_condition['value'] = '%' . trim(piv_base_transliterate_string($q)) . '%';
              }
            }
          }
        }
      }
    }
  }
}

/**
 * Resave all poems to populate the field_plain_title.
 */
function _piv_base_resave_poems() {
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'poem')
    ->notExists('field_plain_title')
    ->execute();
  if (php_sapi_name() == "cli") {
    $count = count($nids);
    print "Updating $count poems.\n";
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($nids as $nid) {
    $node = $storage->load($nid);
    $node->save();
  }
}

/**
 * Implements hook_preprocess_block().
 */
function piv_base_preprocess_block(&$variables) {
  if ($variables['elements']['#base_plugin_id'] === 'field_block') {
    if (!empty($variables['label'])) {
      $variables['label'] = $variables['content'][0]['#title'] ?? $variables['label'];
    }
  }
}

/**
 * Implements hook_preprocess_image().
 */
function piv_base_preprocess_image(&$variables) {
  // Slideshow and header images.
  if ($variables['style_name'] == 'focal_point_2000x800') {
    $variables['attributes']['loading'] = 'eager';
  }
}

/**
 * Implements hook_library_info_alter().
 */
function piv_base_library_info_alter(&$libraries, $extension) {
  if ($extension == 'bootstrap_barrio') {
    if (isset($libraries['fontawesome'])) {
      // Unset and load with custom code in the theme html.html.twig.
      unset($libraries['fontawesome']);
    }
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Preprocess homepage slideshow to display content in our own template.
 */
function piv_base_preprocess_views_view_fields__home_page_slider_fca__block_1(&$variables) {
  $block = $variables['row']?->_entity;
  $variables['welcome_modal'] = $block->field_welcome_modal_->value ? ' open-welcome-modal' : '';
  $variables['link_if_not_to_story_page'] = '';
  if ($block?->field_link_if_not_to_story_page[0] ?? NULL) {
    $url = $block->field_link_if_not_to_story_page[0]->getUrl()->toString();
    if ($url) {
      $variables['link_if_not_to_story_page'] = "href='$url'";
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function piv_base_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables) {
  $view = $variables['view'] ?? NULL;
  if ($view) {
    $id = $view->id();
    $display = $view->current_display;
    $suggestions[] = "views_view_fields__{$id}__{$display}";
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function piv_base_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'] ?? NULL;
  if ($view && $view->id() == 'header_images_based_on_node_content') {
    $variables['is_empty'] = TRUE;
    $node = $variables['row']?->_entity ?? NULL;
    if ($node && $node?->field_images_insert?->entity) {
      $variables['is_empty'] = FALSE;
    }
  }
}
