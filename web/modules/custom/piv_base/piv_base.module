/**
 * Implements hook_cron().
 */
function piv_base_cron(): void {
  if (!piv_base_should_regenerate_roulette_cache()) {
    return;
  }

  $script = dirname(DRUPAL_ROOT) . '/private/scripts/roulette/generate-cache.php';
  if (!is_readable($script)) {
    return;
  }

  passthru('php ' . escapeshellarg($script), $exit_code);
  if ($exit_code === 0) {
    \Drupal::state()->set('piv_base.roulette_cache_last_run', \Drupal::time()->getRequestTime());
  }
}

/**
 * Determines whether Poem Roulette caches should be regenerated.
 */
function piv_base_should_regenerate_roulette_cache(): bool {
  $interval = (int) (getenv('ROULETTE_CACHE_INTERVAL') ?: 86400);
  $last_run = (int) \Drupal::state()->get('piv_base.roulette_cache_last_run', 0);
  if (\Drupal::time()->getRequestTime() - $last_run < $interval) {
    return FALSE;
  }

  if (isset($_ENV['PANTHEON_ENVIRONMENT'])) {
    return $_ENV['PANTHEON_ENVIRONMENT'] === 'live';
  }

  if (isset($_ENV['PLATFORM_ENVIRONMENT_TYPE'])) {
    return $_ENV['PLATFORM_ENVIRONMENT_TYPE'] === 'production';
  }

  return FALSE;
}

/**
 * Implements hook_s3fs_upload_params_alter().
 *
 * Bucket piv-lvp-images-and-files uses "Bucket owner enforced" (ACLs disabled).
 */
function piv_base_s3fs_upload_params_alter(array &$upload_params): void {
  unset($upload_params['ACL']);
}

/**
 * Implements hook_s3fs_copy_params_alter().
 */
function piv_base_s3fs_copy_params_alter(array &$copy_params, array $s3_key_paths): void {
  unset($copy_params['ACL']);
}

/**
 * Implements hook_user_format_name_alter().
 */
function piv_base_user_format_name_alter(&$name, AccountInterface $account) {
  if ($account->isAuthenticated()) {
    $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
    if ($user) {
      $first_name = $user->piv_teacher_first_name->value;
      $last_name = $user->piv_teacher_last_name->value;
      if ($first_name || $last_name) {
        $name = trim("$first_name $last_name");
      }
    }
  }
}

/**
 * Implements hook_entity_form_mode_alter().
 */
function piv_base_entity_form_mode_alter(&$form_mode, EntityInterface $entity) {
  // Change the poet school visit form nodes if they are created by a teacher
  // that is not an admin.
  if ($entity->getEntityTypeId() == 'node' && $entity->bundle() == 'pal_pir_school_visit') {
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if ($current_user->id() != 1
    && !in_array('superadmin', $roles)
    && in_array('teacher', $roles)) {
      $form_mode = 'teacher';
    }
  }
  if ($entity->getEntityTypeId() == 'user') {
    $current_user = \Drupal::currentUser();
    if (!$current_user->hasPermission('administer site configuration')) {
      if ($entity->hasRole('teacher')) {
        $form_mode = 'teacher_edit';
      }
      elseif ($entity->hasRole('poet_network')) {
        $form_mode = 'poet_network';
      }
      // Else, just go with default.
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function piv_base_preprocess_menu_local_tasks(&$variables) {
  $current_user = $variables['user'];
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() == 'entity.node.edit_form') {
    $node = $route->getParameter('node');
    if ($node->bundle() == 'pal_pir_school_visit') {
      $roles = $current_user->getRoles();
      if ($current_user->id() != 1
      && !in_array('superadmin', $roles)
      && in_array('teacher', $roles)) {
        // Disable secondary menu on poet visit school node if user is not
        // admin.
        unset($variables['secondary']['form_mode_manager.entities:form_mode_manager.node.teacher.task_tab']);
        if (count($variables['secondary']) == 1) {
          $variables['secondary'] = [];
        }
      }
    }
    return;
  }

  // Disable form modes for users if not admin.
  if (!$current_user->hasPermission('administer site configuration')) {
    unset($variables['primary']['form_mode_manager.entities:form_mode_manager.user.poet_network.task_tab']);
    unset($variables['primary']['form_mode_manager.entities:form_mode_manager.user.poets.task_tab']);
    unset($variables['primary']['form_mode_manager.entities:form_mode_manager.user.teacher_edit.task_tab']);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function piv_base_form_user_form_alter(&$form, FormStateInterface $form_state) {
  // Prevent non-admin users from removing the judge role.
  $current_user = \Drupal::currentUser();
  if (
    isset($form['account']['roles']['#options']['judge'])
    && in_array('judge', $form['account']['roles']['#default_value'], TRUE)
    && !$current_user->hasRole('administrator')
  ) {
    $form['account']['roles']['judge']['#disabled'] = TRUE;
  }
}

/**
 * Implements hook_form_alter().
 */
function piv_base_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (in_array($form_id, [
    'paragraph_poet_questionnaire_form',
    'paragraph_teacher_questionnaire_form',
  ])) {
    $form['actions']['submit']['#submit'][] = 'piv_base_form_survey_custom_submit';
  }

  if (in_array($form_id, [
    'node_pal_pir_school_visit_form',
    'node_pal_pir_school_visit_edit_form',
  ])) {
    $current_user = \Drupal::currentUser();
    $roles = $current_user->getRoles();
    if ($current_user->id() != 1 && !in_array('superadmin', $roles)) {
      $form['langcode']['#access'] = FALSE;
    }

    $form_display = $form_state->getStorage()['form_display'];
    if ($form_display && $form_display->getMode() == 'teacher') {
      $form['field_preferred_poet_s_']['#states'] = [
        'visible' => [
          ':input[name="field_do_you_have_any_poet_prefe[value]"]' => ['checked' => TRUE],
        ],
      ];
      $form['field_date_and_start_time']['#states'] = [
        'visible' => [
          ':input[name="field_preferred_date[value]"]' => ['checked' => TRUE],
        ],
      ];
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function piv_base_node_presave(EntityInterface $entity) {
  if ($entity->bundle() == 'pal_pir_school_visit') {
    // Title is the node created time or current time in case of new node.
    $entity->title = $entity->created->value ?? \Drupal::time()->getCurrentTime();
  }
  elseif ($entity->bundle() == 'poem') {
    $entity->title = str_replace("'", "’", $entity->label());
  }

  if ($entity->hasField('field_plain_title')) {
    $entity->field_plain_title = trim(piv_base_transliterate_string(strip_tags($entity->label())));
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * If the source changed in remote video, remove the media title, so oEmbed will
 * update it with data from the source url. Otherwise the media will retain the
 * original title when updating a url.
 */
function piv_base_media_presave(EntityInterface $entity) {
  // @see Drupal\media\Entity\Media::hasSourceFieldChanged()
  if ($entity->bundle() == 'remote_video') {
    $source = $entity->getSource();
    $has_source_field_changed = isset($entity->original) && $source->getSourceFieldValue($entity) !== $source->getSourceFieldValue($entity->original);
    if ($has_source_field_changed) {
      $entity->setName(NULL);
    }
  }
}

/**
 * Implements hook_entity_create_access().
 */
function piv_base_entity_create_access(AccountInterface $account, array $context, $entity_bundle) {
  // Prevent teachers with no schools from creating school visits.
  $entity_type_id = $context['entity_type_id'] ?? NULL;
  if ($entity_type_id == 'node' && $entity_bundle == 'pal_pir_school_visit') {
    $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
    if (!$user) {
      return AccessResult::forbidden();
    }
    $school = $user->field_school->entity ?? NULL;
    if (!$school || (int) ($school->field_allow_poet_visits_school?->value) !== 1) {
      return AccessResult::forbidden();
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_system_breadcrumb_alter().
 */
function piv_base_system_breadcrumb_alter(Breadcrumb &$breadcrumb, RouteMatchInterface $route_match, array $context): void {
  // Vary the breadcrumb cache by user role so anonymous and authenticated
  // users never share the same cached breadcrumb.
  $breadcrumb->addCacheContexts(['user.roles']);

  // Hide the "Add content" breadcrumb link for anonymous users only.
  if (\Drupal::currentUser()->isAuthenticated()) {
    return;
  }

  $links = $breadcrumb->getLinks();
  $filtered = array_filter($links, static function ($link) {
    $url = $link->getUrl();
    return !($url->isRouted() && $url->getRouteName() === 'node.add_page');
  });

  if (count($filtered) === count($links)) {
    return;
  }

  $new_breadcrumb = new Breadcrumb();
  $new_breadcrumb->addCacheContexts(['user.roles']);
  foreach ($filtered as $link) {
    $new_breadcrumb->addLink($link);
  }
  $new_breadcrumb->addCacheableDependency($breadcrumb);
  $breadcrumb = $new_breadcrumb;
}

/**
 * Implements hook_theme().
 */
function piv_base_theme($existing, $type, $theme, $path) {
  return [
    'piv_welcome_modal' => [
      'render element' => 'content',
      'variables' => [
        'menu' => NULL,
        'form' => NULL,
      ],
    ],
    'piv_back_link' => [
      'render element' => 'content',
      'variables' => [
        'link' => NULL,
      ],
    ],
    // Custom theme to render youtube videos without oembed and with jsonapi
    // enabled.
    'piv_youtube' => [
      'render element' => 'content',
      'variables' => [
        'url' => NULL,
        'id' => NULL,
      ],
    ],
    'piv_school_visits_summary' => [
      'variables' => [
        'data' => [],
        'filters' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_html().
 */
function piv_base_preprocess_html(&$variables) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['langcode'] = $langcode;

  $route = \Drupal::routeMatch();
  if ($route->getRouteName() == 'entity.node.canonical') {
    if ($node = $route->getParameter('node')) {
      // If there is no translation for the current node to the current site
      // language, redirect the user to the original node language url.
      if (!$node->hasTranslation($langcode)) {
        $default_language = $node->language();
        // Non-system language.
        if (!$default_language->isLocked()) {
          $url = $node->toUrl();
          $url->setOption('language', $default_language);
          $response = new RedirectResponse($url->toString());
          $response->send();
          return;
        }
      }
    }
  }
  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    $entity_type_manager = \Drupal::entityTypeManager();
    $block = $entity_type_manager->getStorage('block')->load('useraccountmenu');
    $variables['page_bottom'][] = [
      '#theme' => 'piv_welcome_modal',
      '#menu' => $entity_type_manager->getViewBuilder('block')->view($block),
      '#form' => \Drupal::formBuilder()->getForm('\Drupal\piv_base\Form\PivWelcomeModal'),
    ];
  }

  // Avoid empty titles like "| Poetry in Voice" when the page title is missing.
  if (!empty($variables['head_title']) && is_array($variables['head_title'])) {
    $variables['head_title'] = array_filter(
      $variables['head_title'],
      static fn ($part) => trim((string) $part) !== ''
    );
  }
}

/**
 * Custom submit handler for paragraph surveys.
 */
function piv_base_form_survey_custom_submit($form, FormStateInterface $form_state) {
  $paragraph = $form_state->getFormObject()->getEntity();
  $node = $form_state->get('survey_paragraph_node') ?? $paragraph->getParentEntity();
  // If editing a paragraph that exists, the field_name will be empty. It is not
  // a problem since the node already references the paragraph.
  $field_name = $form_state->get('survey_paragraph_field');
  if ($node && $field_name && $paragraph) {
    $node->{$field_name} = $paragraph;
    $node->save();
  }
  if ($paragraph->bundle() == 'poet_questionnaire') {
    $form_state->setRedirect('piv_base.poet_survey_view', [
      'node' => $node->id(),
    ]);
  }
  elseif ($paragraph->bundle() == 'teacher_questionnaire') {
    $form_state->setRedirect('piv_base.teacher_survey_view', [
      'node' => $node->id(),
    ]);
  }

  \Drupal::messenger()->addMessage(t('The changes have been saved.'));
}

/**
 * Implements hook_preprocess_HOOK().
 */
function piv_base_preprocess_links__language_block(&$variables) {
  $route = \Drupal::routeMatch();
  $route_name = $route->getRouteName();
  if ($route_name == 'entity.node.canonical') {
    // If there is no translation, the language switcher should redirect the
    // user to the frontpage.
    if ($node = $route->getParameter('node')) {
      foreach ($variables['links'] as $langcode => &$link) {
        if (!$node->hasTranslation($langcode)) {
          // Language is already set in the link options.
          $link['link']['#url'] = Url::fromRoute('<front>');
        }
      }
    }
  }
  // Unset the links for the current language.
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  unset($variables['links'][$langcode]);
}

/**
 * Implements hook_page_attachments_alter().
 */
function piv_base_page_attachments_alter(array &$attachments) {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    // Do not alter favicon for admin routes.
    return;
  }

  global $base_path;
  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $theme = \Drupal::theme()->getActiveTheme();
  $favicon = "{$base_path}{$theme->getPath()}/favicon-{$langcode}.ico";

  // Replace only the favicon; keep canonical, hreflang, and other head links.
  $head_links = $attachments['#attached']['html_head_link'] ?? [];
  $attachments['#attached']['html_head_link'] = array_values(array_filter($head_links, static function ($link_item) {
    $attributes = is_array($link_item) ? ($link_item[0] ?? $link_item) : [];
    $rel = $attributes['rel'] ?? '';
    return $rel !== 'icon' && $rel !== 'shortcut icon';
  }));
  $attachments['#attached']['html_head_link'][][] = [
    'rel' => 'icon',
    'href' => UrlHelper::stripDangerousProtocols($favicon),
    'type' => 'image/vnd.microsoft.icon',
  ];

  if (\Drupal::routeMatch()->getRouteName() !== 'entity.user.canonical') {
    return;
  }

  $user = \Drupal::routeMatch()->getParameter('user');
  if (!$user instanceof UserInterface || $user->get('user_picture')->isEmpty()) {
    return;
  }

  $file = $user->get('user_picture')->entity;
  if (!$file) {
    return;
  }

  $image_style = ImageStyle::load('og_image') ?: ImageStyle::load('1280x720');
  $image_url = $image_style
    ? $image_style->buildUrl($file->getFileUri())
    : \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());

  $schema = [
    '@context' => 'https://schema.org',
    '@type' => 'ProfilePage',
    'mainEntity' => [
      '@type' => 'Person',
      'name' => $user->getDisplayName(),
      'url' => $user->toUrl('canonical', ['absolute' => TRUE])->toString(),
      'image' => $image_url,
    ],
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => [
        'type' => 'application/ld+json',
      ],
      '#value' => json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE),
    ],
    'piv_poet_profile_schema',
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function piv_base_preprocess_node(&$variables) {
  // Add a print button to all node types.
  global $base_path;
  $path = \Drupal::service('extension.list.module')->getPath('piv_base');
  $image_path = "{$base_path}{$path}/assets/print_icon.gif";
  $markup = Markup::create("<img src='{$image_path}' onclick='window.print()' class='print-icon' style='cursor: pointer;'>");
  $variables['print_button'] = [
    '#markup' => $markup,
  ];
}

/**
 * Implements hook_preprocess_page().
 */
function piv_base_preprocess_page($variables) {
  // Catch exception messages and display as errors. Messages set before
  // throwing an exception will be ignored.
  // @see https://www.drupal.org/project/drupal/issues/885896
  $exception = \Drupal::request()->get('exception');
  if ($exception) {
    if ($message = $exception->getMessage()) {
      \Drupal::messenger()->addError(t($message)); // @phpcs:ignore
    }
  }
}

/**
 * Implements hook_preprocess_piv_youtube().
 */
function template_preprocess_piv_youtube(&$variables) {
  if (!empty($variables['id'])) {
    return;
  }

  if (!empty($variables['url'])) {
    // Extract the id from a url.
    $regexp = '/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i';
    preg_match($regexp, $variables['url'], $match);
    $id = $match[1] ?? NULL;
    if ($id) {
      $variables['id'] = $id;
    }
  }
}

/**
 * Transliterate a string.
 */
function piv_base_transliterate_string($string) {
  // Remove accents, etc.
  $string = \Drupal::transliteration()->removeDiacritics($string);
  // Remove everything that is not alphanumeric or space.
  return preg_replace('/[^A-Za-z0-9 ]/', '', $string);
}

/**
 * Implements hook_views_pre_view().
 */
function piv_base_views_pre_view(ViewExecutable $view, $display_id, array &$args): void {
  if ($view->id() !== 'user_listing_index_pages') {
    return;
  }

  $exposed = $view->getExposedInput();
  $search = trim((string) ($exposed['combine'] ?? ''));
  if ($search === '') {
    return;
  }

  // Name searches are unusable when the default random sort is still applied.
  $sort = $exposed['sort_bef_combine'] ?? '';
  if ($sort === '' || $sort === 'random_ASC') {
    $view->setExposedInput(['sort_bef_combine' => 'piv_teacher_last_name_value_ASC'] + $exposed);
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Kept under this name because Drupal 11 already compiled it as a hook
 * implementation. Do not rename.
 */
function piv_contest_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() == 'language_restricted_poems') {
    // This view is a entity reference view, code below alters the query on the
    // search string in a autocomplete to sanitize the values there, ignoring
    // any non alphanumeric or space character. Views get the searched string
    // from the route parameters directly (it is the $_GET['q']).
    foreach ($query->where as &$condition_group) {
      foreach ($condition_group['conditions'] as &$condition) {
        if (is_a($condition['field'], 'Drupal\Core\Database\Query\Condition')) {
          foreach ($condition['field']->conditions() as &$inner_condition) {
            if (is_array($inner_condition) && !empty($inner_condition['field'])) {
              if ($inner_condition['field'] == 'node__field_plain_title.field_plain_title_value') {
                $q = $inner_condition['value'];
                $inner_condition['value'] = '%' . trim(piv_base_transliterate_string($q)) . '%';
              }
            }
          }
        }
      }
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function piv_base_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() === 'user_listing_index_pages' && $query instanceof Sql) {
    piv_base_alter_poet_listing_name_search($view, $query);
  }
}

/**
 * Expand poets listing search so first + last name match "Rob Taylor".
 */
function piv_base_alter_poet_listing_name_search(ViewExecutable $view, Sql $query): void {
  $search = trim((string) ($view->getExposedInput()['combine'] ?? ''));
  if ($search === '') {
    return;
  }

  $first_table = _piv_base_views_ensure_user_field_table($query, 'piv_teacher_first_name');
  $last_table = _piv_base_views_ensure_user_field_table($query, 'piv_teacher_last_name');
  if (!$first_table || !$last_table) {
    return;
  }

  $connection = \Drupal::database();
  $like = '%' . $connection->escapeLike($search) . '%';
  $name_or = new Condition('OR');
  $name_or->where("CONCAT_WS(' ', {$first_table}.piv_teacher_first_name_value, {$last_table}.piv_teacher_last_name_value) LIKE :poet_full_name", [
    ':poet_full_name' => $like,
  ]);
  $name_or->condition("{$first_table}.piv_teacher_first_name_value", $like, 'LIKE');
  $name_or->condition("{$last_table}.piv_teacher_last_name_value", $like, 'LIKE');

  $words = preg_split('/\s+/u', $search, -1, PREG_SPLIT_NO_EMPTY) ?: [];
  if (count($words) > 1) {
    $all_words = new Condition('AND');
    foreach ($words as $word) {
      $word_like = '%' . $connection->escapeLike($word) . '%';
      $word_or = new Condition('OR');
      $word_or->condition("{$first_table}.piv_teacher_first_name_value", $word_like, 'LIKE');
      $word_or->condition("{$last_table}.piv_teacher_last_name_value", $word_like, 'LIKE');
      $all_words->condition($word_or);
    }
    $name_or->condition($all_words);
  }

  $combine_conditions = [];
  foreach ($query->where as $group_id => $group) {
    if (empty($group['conditions']) || !is_array($group['conditions'])) {
      continue;
    }
    foreach ($group['conditions'] as $delta => $condition) {
      if (piv_base_is_views_combine_condition($condition)) {
        $combine_conditions[] = $condition;
        unset($query->where[$group_id]['conditions'][$delta]);
      }
    }
    if (isset($query->where[$group_id]['conditions'])) {
      $query->where[$group_id]['conditions'] = array_values($query->where[$group_id]['conditions']);
    }
  }

  $search_or = new Condition('OR');
  foreach ($combine_conditions as $condition) {
    $field = $condition['field'] ?? NULL;
    if ($field instanceof Condition) {
      $search_or->condition($field);
      continue;
    }
    if (is_string($field)) {
      $search_or->where($field, $condition['value'] ?? []);
    }
  }
  $search_or->condition($name_or);
  $query->addWhere('poet_name_search', $search_or);
}

/**
 * Join a user field table onto a user Views query.
 */
function _piv_base_views_ensure_user_field_table(Sql $query, string $field_name): ?string {
  $table = 'user__' . $field_name;
  $alias = $query->ensureTable($table);
  if ($alias) {
    return $alias;
  }

  $base = $query->ensureTable('users_field_data') ?: 'users_field_data';
  $join = Views::pluginManager('join')->createInstance('standard', [
    'type' => 'LEFT',
    'table' => $table,
    'field' => 'entity_id',
    'left_table' => $base,
    'left_field' => 'uid',
    'extra' => [
      [
        'field' => 'deleted',
        'value' => 0,
        'numeric' => TRUE,
      ],
    ],
  ]);
  return $query->addTable($table, NULL, $join);
}

/**
 * Checks whether a Views where condition is the Combine fields filter.
 */
function piv_base_is_views_combine_condition(array $condition): bool {
  $field = $condition['field'] ?? NULL;
  if ($field instanceof Condition) {
    foreach ($field->conditions() as $inner) {
      if (is_array($inner) && piv_base_is_views_combine_condition($inner)) {
        return TRUE;
      }
    }
    return FALSE;
  }
  if (!is_string($field)) {
    return FALSE;
  }
  return stripos($field, 'CONCAT_WS') !== FALSE || stripos($field, 'CONCAT(') !== FALSE;
}

/**
 * Implements hook_simple_sitemap_entity_query_alter().
 */
function piv_base_simple_sitemap_entity_query_alter($query, $entity_type_id = NULL, $bundle = NULL): void {
  if (!$query instanceof QueryInterface) {
    return;
  }

  $type = $entity_type_id;
  if (!$type && method_exists($query, 'getEntityTypeId')) {
    $type = $query->getEntityTypeId();
  }
  if ($type !== 'user') {
    return;
  }

  $query->condition('status', 1);
  $query->condition('roles', 'poet');
}

/**
 * Implements hook_simple_sitemap_links_alter().
 */
function piv_base_simple_sitemap_links_alter(array &$links, $sitemap = NULL): void {
  foreach ($links as $key => $link) {
    $entity_type = $link['meta']['entity_info']['entity_type'] ?? '';
    $url = (string) ($link['url'] ?? $link['path'] ?? '');
    $is_user_entity = $entity_type === 'user';
    $is_user_path = (bool) preg_match('#/(index\.php/)?user/\d+(/|$)#', $url);
    if (!$is_user_entity && !$is_user_path) {
      continue;
    }
    if (!preg_match('#(read/poets|lire/poetes)/#', $url)) {
      unset($links[$key]);
    }
  }
}

/**
 * Resave all poems to populate the field_plain_title.
 */
function _piv_base_resave_poems() {
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'poem')
    ->notExists('field_plain_title')
    ->execute();
  if (php_sapi_name() == "cli") {
    $count = count($nids);
    print "Updating $count poems.\n";
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($nids as $nid) {
    $node = $storage->load($nid);
    $node->save();
  }
}

/**
 * Implements hook_preprocess_block().
 */
function piv_base_preprocess_block(&$variables) {
  if ($variables['elements']['#base_plugin_id'] === 'field_block') {
    if (!empty($variables['label'])) {
      $variables['label'] = $variables['content'][0]['#title'] ?? $variables['label'];
    }
  }
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function piv_base_preprocess_views_view_field(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'user_listing_index_pages' || $view->current_display !== 'block_7') {
    return;
  }

  $field = $variables['field'];
  if (($field->options['id'] ?? '') !== 'view_user') {
    return;
  }

  $row = $variables['row'];
  if (empty($row->_entity) || $row->_entity->getEntityTypeId() !== 'user') {
    return;
  }

  /** @var \Drupal\user\UserInterface $user */
  $user = $row->_entity;
  $image_attributes = [
    'class' => ['image', 'poet-related-teaser-image'],
    'role' => 'img',
    'aria-label' => $user->getDisplayName(),
  ];

  if (!$user->get('user_picture')->isEmpty() && ($file = $user->get('user_picture')->entity)) {
    $image_style = ImageStyle::load('focal_point_700_x_');
    $image_url = $image_style
      ? $image_style->buildUrl($file->getFileUri())
      : \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
    $image_attributes['style'] = 'background-image: url("' . $image_url . '");';
  }

  $bio = '';
  if ($user->hasField('field_user_bio') && !$user->get('field_user_bio')->isEmpty()) {
    $bio = Unicode::truncate(strip_tags($user->get('field_user_bio')->value), 150, TRUE, TRUE);
  }

  $variables['output'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['index-views', 'mixtape', 'content-index'],
      'data-nosnippet' => 'true',
    ],
    'link' => [
      '#type' => 'link',
      '#title' => [
        '#type' => 'container',
        'image' => [
          '#type' => 'html_tag',
          '#tag' => 'div',
          '#attributes' => $image_attributes,
        ],
        'content' => [
          '#type' => 'container',
          '#attributes' => ['class' => ['content']],
          'title' => [
            '#type' => 'html_tag',
            '#tag' => 'h3',
            '#value' => $user->getDisplayName(),
          ],
          'bio' => [
            '#type' => 'html_tag',
            '#tag' => 'p',
            '#value' => $bio,
          ],
        ],
      ],
      '#url' => $user->toUrl(),
      '#attributes' => ['class' => ['area-link']],
      '#options' => ['attributes' => ['class' => ['area-link']]],
    ],
  ];
}

/**
 * Implements hook_preprocess_image().
 */
function piv_base_preprocess_image(&$variables) {
  // Slideshow and header images.
  if ($variables['style_name'] == 'focal_point_2000x800') {
    $variables['attributes']['loading'] = 'eager';
    $variables['attributes']['fetchpriority'] = 'high';

    $user = \Drupal::routeMatch()->getParameter('user');
    if ($user instanceof UserInterface && empty($variables['attributes']['alt'])) {
      $variables['attributes']['alt'] = t('Photo of @name', ['@name' => $user->getDisplayName()]);
    }
  }
}

/**
 * Implements hook_library_info_alter().
 */
function piv_base_library_info_alter(&$libraries, $extension) {
  if ($extension == 'bootstrap_barrio') {
    if (isset($libraries['fontawesome'])) {
      // Unset and load with custom code in the theme html.html.twig.
      unset($libraries['fontawesome']);
    }
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Preprocess homepage slideshow to display content in our own template.
 */
function piv_base_preprocess_views_view_fields__home_page_slider_fca__block_1(&$variables) {
  $block = $variables['row']?->_entity;
  $variables['welcome_modal'] = $block->field_welcome_modal_->value ? ' open-welcome-modal' : '';
  $variables['link_if_not_to_story_page'] = '';
  if ($block?->field_link_if_not_to_story_page[0] ?? NULL) {
    $url = $block->field_link_if_not_to_story_page[0]->getUrl()->toString();
    if ($url) {
      $variables['link_if_not_to_story_page'] = "href='$url'";
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function piv_base_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables) {
  $view = $variables['view'] ?? NULL;
  if ($view) {
    $id = $view->id();
    $display = $view->current_display;
    $suggestions[] = "views_view_fields__{$id}__{$display}";
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function piv_base_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'] ?? NULL;
  if ($view && $view->id() == 'header_images_based_on_node_content') {
    $variables['is_empty'] = TRUE;
    $node = $variables['row']?->_entity ?? NULL;
    if ($node && $node?->field_images_insert?->entity) {
      $variables['is_empty'] = FALSE;
    }
  }
}

/**
 * Join words naturally, e.g. "red, blue and green".
 */
function piv_base_natural_join(array $items, string $langcode = 'en'): string {
  if (!$items) {
    return '';
  }

  $conjunction = match ($langcode) {
    'fr' => ' et ',
    default => ' and ',
  };

  $last = array_pop($items);
  return $items ? implode(', ', $items) . $conjunction . $last : $last;
}
