<?php

/**
 * @file
 * Primary module hooks for PIV Constest module.
 */

/**
 * Implements hook_entity_type_alter().
 */
function piv_contest_entity_type_alter(array &$entity_types) {
  $entity_types['paragraph']->addConstraint('stream_constraint');
}


function teste() {
  //$s = Drupal::service('plugin.manager.score_form');
  //$s->createInstance('default');

  $s = Drupal::service('piv_contest.score_form_builder');
  $score_template = \Drupal::entityTypeManager()->getStorage('score_template')->load(1);
  $s->getForm($score_template);
}
