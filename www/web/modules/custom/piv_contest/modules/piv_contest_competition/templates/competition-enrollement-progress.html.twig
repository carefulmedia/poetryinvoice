{#
/**
 * @file
 *  Displays the enrollement progress to a competition for a given school.
 */
#}
<section id="enrollment">
  <table>
    <tr>
      <td>{{ 'Stream' |t }}</td>
      <td>{{ 'Name' |t }}</td>
      <td>{{ 'Recitations' |t }}</td>
      <td>{{ 'Permission' |t }}</td>
      <td></td>
    </tr>
    {% for stream in streams %}
      <tr {{ stream.is_completed ? 'class="completed"' }}>
        <td>{{ stream.name }}</td>
        <td>{{ stream.student }}</td>
        <td {{ stream.is_recitations_completed ? 'class="completed"' }}>{{ stream.recitations }}</td>
        <td {{ stream.is_permissions_completed ? 'class="completed"' }}>{{ stream.permissions }}</td>
        <td>{{ stream.permissions }}</td>
        <td>
          {% for link in stream.links %}
            {{ link }}
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
  </table>
</section>

