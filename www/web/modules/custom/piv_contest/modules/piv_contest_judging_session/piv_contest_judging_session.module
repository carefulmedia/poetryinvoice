<?php

/**
 * @file
 * Provides a judging session entity type.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormState;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Render\Element;
use Drupal\piv_contest_competition\Entity\Competition;

/**
 * Implements hook_theme().
 */
function piv_contest_judging_session_theme() {
  return [
    'judging_session' => [
      'render element' => 'elements',
    ],
    'recitation_judging' => [
      'render element' => 'elements',
    ],
    'poem_read_poems' => [
      'render element' => 'elements',
    ],
  ];
}

/**
 * Implements template_preprocess_HOOK().
 */
function template_preprocess_recitation_judging(array &$variables) {
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements template_preprocess_HOOK().
 */
function template_preprocess_poem_read_poems(array &$variables) {
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function piv_contest_judging_session_form_judging_session_default_edit_form_alter(&$form, FormStateInterface $form_state) {
  _piv_contest_judging_session_manage_session_form($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function piv_contest_judging_session_form_judging_session_default_session_management_ui_form_alter(&$form, FormStateInterface $form_state) {
  _piv_contest_judging_session_manage_session_form($form, $form_state);
}

/**
 * Alter forms on session management.
 */
function _piv_contest_judging_session_manage_session_form(&$form, FormStateInterface $form_state) {
  // Set both judge fields as no access by default.
  $form['field_english_judge']['#access'] = FALSE;
  $form['field_french_judge']['#access'] = FALSE;
  $form['field_competition']['#access'] = FALSE;

  $form['field_stream']['widget'][0]['target_id']['#ajax'] = [
    'callback' => 'piv_contest_judging_session_ajax_update',
    'wrapper' => 'form-wrapper',
  ];

  $user_input = $form_state->getUserInput();
  if (isset($user_input['field_stream'][0]['target_id'])) {
    $stream_value = (int) $user_input['field_stream'][0]['target_id'];
  }
  else {
    if (isset($form['field_stream']['widget'][0]['target_id']['#default_value'])) {
      $stream_value = $form['field_stream']['widget'][0]['target_id']['#default_value'];
    }
    else {
      $stream_value = array_key_first($form['field_stream']['widget'][0]['target_id']['#options']);
    }
  }

  $competition = \Drupal::routeMatch()->getParameter('competition');
  if (!$competition) {
    if (!isset($form['field_competition']['widget'][0]['target_id']['#default_value'])) {
      return;
    }
    $competition = $form['field_competition']['widget'][0]['target_id']['#default_value'];
  }

  $stream = piv_contest_judging_session_get_stream_by_competition_and_id($competition, $stream_value);
  if (!$stream) {
    return;
  }

  foreach ($stream->field_stream_languages as $language_field) {
    switch ($language_field->target_id) {
      case 'en':
        $form['field_english_judge']['#access'] = TRUE;
        break;

      case 'fr':
        $form['field_french_judge']['#access'] = TRUE;
        break;
    }
  }

  $form['#prefix'] = '<div id="form-wrapper">';
  $form['#suffix'] = '</div>';

  $form['actions']['submit']['#validate'][] = '::validateForm';
  $form['actions']['submit']['#validate'][] = 'piv_contest_judging_session_validate_judges';
}

/**
 * Custom validation for the judging session.
 */
function piv_contest_judging_session_validate_judges(&$form, FormState $form_state) {
  if ($form['field_english_judge']['#access'] && $form['field_french_judge']['#access']) {
    $english_judges = $form_state->getValue('field_english_judge');
    $french_judges = $form_state->getValue('field_french_judge');

    $total_english_judges = 0;
    $total_french_judges = 0;

    foreach ($english_judges as $judge_item) {
      if (is_array($judge_item) && $judge_item['target_id']) {
        $total_english_judges++;
      }
    }

    foreach ($french_judges as $judge_item) {
      if (is_array($judge_item) && $judge_item['target_id']) {
        $total_french_judges++;
      }
    }

    if ($total_french_judges !== $total_english_judges) {
      $form_state->setErrorByName('field_english_judge', t('You must add the same number of Judges for each language.'));
      $form_state->setErrorByName('field_french_judge', t('You must add the same number of Judges for each language.'));
    }
  }
}

/**
 * Get stream by competition and id.
 */
function piv_contest_judging_session_get_stream_by_competition_and_id(Competition $competition, ?int $id) {
  foreach ($competition->field_competition_streams as $item) {
    if ((int) $item->target_id === $id) {
      return $item->entity;
    }
  }
}

/**
 * Ajax update form.
 */
function piv_contest_judging_session_ajax_update($form, FormStateInterface $form_state) {
  $form_state->setRebuild();
  return $form;
}

/**
 * Implements hook_aggregator_fetcher_info_alter().
 */
function piv_contest_judging_session_preprocess_competition(&$variables) {
  if ($variables['elements']['#view_mode'] != 'full') {
    return;
  }

  $current_user = \Drupal::currentUser();
  if ($current_user->hasPermission('manage judging sessions')) {
    $competition = $variables['elements']['#competition'];

    $variables['content']['manage_session'] = Link::createFromRoute(t('Manage Sessions'), 'piv_contest_judging_session.manage_sessions', [
      'competition' => $competition->id(),
    ])->toRenderable() + ['#weight' => -99];
    $variables['content']['competition_progress'] = Link::createFromRoute(t('Competition Progress'), 'piv_contest_judging_session.competition_progress', [
      'competition' => $competition->id(),
    ])->toRenderable() + ['#weight' => -98];
    $variables['content']['manage_session']['#prefix'] = '<div>';
    $variables['content']['manage_session']['#suffix'] = '</div>';
    $variables['content']['competition_progress']['#prefix'] = '<div>';
    $variables['content']['competition_progress']['#suffix'] = '</div>';

  }

}

/**
 * Prepares variables for judging session templates.
 *
 * Default template: judging-session.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the judging session information
 *     and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_judging_session(array &$variables) {
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_entity_presave().
 */
function piv_contest_judging_session_judging_session_presave(EntityInterface $entity) {
  $french_judges = array_column($entity->field_french_judge->getValue(), 'target_id');
  $english_judges = array_column($entity->field_english_judge->getValue(), 'target_id');

  $judges = array_merge($french_judges, $english_judges);

  /** @var \Drupal\piv_contest_judging_session\Service\JudgeSession $judge_session_service */
  $judge_session_service = \Drupal::service('piv_contest_judging_session.service.judge_session');

  foreach ($judges as $judge) {
    $session_being_judged = (int) $judge_session_service->getCurrentSessionBeingJudgedByUserID((int) $judge);
    if ($session_being_judged === (int) $entity->id()) {
      $judge_session_service->removeSessionBeingJudgeByUserID((int) $judge);
    }
  }
}

/**
 * Implements hook_field_widget_form_alter().
 *
 * Changes the judge field on judging_session to only let the user select the
 * judges referenced in the competition.
 */
function piv_contest_judging_session_field_widget_form_alter(&$element, FormStateInterface $form_state, $context) {
  if ($element['#entity_type'] == 'judging_session') {
    $field_name = $context['items']->getFieldDefinition()->getName();
    if (in_array($field_name, ['field_accuracy_judge', 'field_english_judge', 'field_french_judge'])) {
      $entity = $form_state->getFormObject()->getEntity();
      if ($competition = $entity->field_competition->entity) {
        $judges = $competition->field_judges->referencedEntities();
        $options = ['_none' => t('- None -')];
        foreach ($judges as $judge) {
          $options[$judge->id()] = $judge->label();
        }
        // Intersect with original options to make sure the filters in the field
        // configurations are considered too.
        $element['#options'] = array_intersect_key($element['#options'], $options);
      }
    }
  }
}
