<div{{ attributes }}>
  {% if content %}
    <div class='recitation-judging__back'>
      {{ content.back }}
    </div>
    <div class='recitation-judging__evaluated'>
      {{ content.recitation_evaluated }}
    </div>
    <div class='recitation-judging__title'>
      {{ content.title }}
    </div>
    <div class='recitation-judging__container'>
      <div class='recitation-judging__video'>
        {{ content.video }}
      </div>
      <div class='recitation-judging__form'>
        {{ content.form }}
      </div>
      <div class='recitation-judging__judge-later'>{{ content.judge_later }}</div>
    </div>
  {% endif %}
</div>
