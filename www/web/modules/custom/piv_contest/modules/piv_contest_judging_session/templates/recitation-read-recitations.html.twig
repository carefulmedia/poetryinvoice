<div{{ attributes }}>
  {% if content %}
    <header>
      <div class='recitation-read__back'>
        {{ content.back }}
      </div>
      <div class='recitation-read__evaluated'>
        {{ content.recitation_reads }}
      </div>
      <h2 class='recitation-read__title'>
        {{ content.title }}
      </h2>
    </header>
    <div class='recitation-read__container'>
      <div class="recitation-read__body">
        {{ content.description }}
      </div>
      <div class='recitation-read__video'>
        {{ content.video }}
      </div>
    </div>
    <div class='recitation-read__next'>{{ content.read_next }}</div>
    <footer>
      <div class='recitation-read__later'>{{ content.read_later }}</div>
    </footer>
  {% endif %}
</div>
